-e7ab-4ce4-a15f-576e825878a0", "type": "paragraph", "frame": {"h": 11.7, "w": 52.8, "x": 5.6, "y": 4.7}, "props": {"bold": true, "text": "Co Bez•li umí?", "color": "#3B82F6", "fontSize": 60, "gradient": {"to": "#9B6CFF", "from": "#6EC6D9", "direction": "135deg"}, "fontFamily": "\"Quicksand\", system-ui, sans-serif"}, "zIndex": 12, "visible": true}, {"id": "46c5a314-edf2-4b97-8008-f26aeda73025", "type": "paragraph", "frame": {"h": 13.7, "w": 48.2, "x": 16.6, "y": 75.3}, "props": {"bold": true, "text": "a mnohem více....", "color": "#dfe0e2", "fontSize": 60, "gradient": null, "fontFamily": "\"Quicksand\", system-ui, sans-serif"}, "visible": true}, {"id": "912b4cf1-c0e0-4a7d-9e5f-d27480223144", "type": "paragraph", "frame": {"h": 18.8, "w": 18.4, "x": 9.7, "y": 19.1}, "props": {"text": "Tvorba učebnic, lekcí, interaktivních prezentací, pracovních listů, procvičování, portfolií, ...", "fontSize": 18}, "visible": true}, {"id": "70cf4987-cbb9-4a7e-a377-87f610e9f3a7", "type": "paragraph", "frame": {"h": 20, "w": 20.2, "x": 41.4, "y": 19.2}, "props": {"text": "Gamifikace, oblíbené app. na jednom místě, živé hry a kvízi, “xpení” žáků, ..."}, "visible": true}, {"id": "cdef45a9-ad84-4fdb-aecd-9f9e54cfd54c", "type": "paragraph", "frame": {"h": 20, "w": 18.5, "x": 9.2, "y": 42.4}, "props": {"text": "Rozvrh, plánování výuky a příprav na hodiny, párování s ŠVP, IVP plán, administrativa, ..."}, "visible": true}, {"id": "6c0d43af-1c5c-49f1-9179-511a4d9cede0", "type": "paragraph", "frame": {"h": 20, "w": 20.7, "x": 41.4, "y": 41.3}, "props": {"text": "AI generuje otázky, plány hodin i studijní materiály. Import PDF, DOCX a PPTX, vlastní avatar, ..."}, "visible": true}, {"id": "3050f1aa-ac2a-49ec-8a53-9893c52a8d46", "type": "paragraph", "frame": {"h": 13.7, "w": 19.1, "x": 9.4, "y": 64.9}, "props": {"text": "Pomocník v tvorbě, není potřeba, aby žáci byli na telefonu. "}, "visible": true}, {"id": "5b6e2ffb-36d3-4037-8d5a-80d91d32fc8e", "type": "image", "frame": {"h": 12.7, "w": 7.3, "x